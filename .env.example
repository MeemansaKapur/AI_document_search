# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local Atlas image: mongodb://localhost:27017/?directConnection=true
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=docsearch
OPENAI_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
CHAT_MODEL=gpt-4o-mini
# Calibrate with: python -m app.evaluate --split dev --calibrate
ABSTAIN_THRESHOLD=0.65
ASK_RATE_LIMIT_PER_MIN=10
# Set true only when running behind Caddy (deploy/), which sets X-Forwarded-For
TRUST_FORWARDED_FOR=false
